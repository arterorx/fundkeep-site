---
import { INDEXABLE, RELEASE, SITE } from '../consts';
import {
  DEFAULT_LOCALE,
  LOCALE_TAGS,
  type Alternate,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/ui';
import { canonicalPath } from '../utils/canonical';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Overrides the default share image. Must be an absolute path. */
  image?: string;
  /** JSON-LD objects to emit in the head. */
  schema?: Record<string, unknown>[];
  /** Keeps a page out of the index even once the site is open (see 404). */
  noindex?: boolean;
  /**
   * Use `title` exactly as given, with no " — Fundkeep" after it. For a title
   * written as a whole for search, like the YNAB export guide's, where the
   * name would push the words that matter past the cut-off.
   */
  exactTitle?: boolean;
  /** The language this page is written in. Sets `<html lang>` and og:locale. */
  lang?: Locale;
  /**
   * Every language version of this page, including itself. Fewer than two
   * means there is no cluster and no hreflang, which is the correct output
   * for a page that exists in one language.
   */
  alternates?: Alternate[];
}

const {
  title,
  description,
  image = '/og.png',
  schema = [],
  noindex = false,
  exactTitle = false,
  lang = DEFAULT_LOCALE,
  alternates = [],
} = Astro.props;

const ui = t(lang);

/* hreflang only for a real cluster, and only on an indexable page. x-default
   goes to English; if a page has no English version it gets no x-default,
   which is what Google asks for rather than a guess. */
const showAlternates = INDEXABLE && !noindex && alternates.length > 1;
const xDefault = alternates.find((entry) => entry.lang === DEFAULT_LOCALE);

const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
/**
 * The name goes at the end of every title — unless the title already carries
 * it, or the page asked for its title exactly. The home page's title leads
 * with the name, and appending it again would print "Fundkeep — … — Fundkeep";
 * checking for the name means no page can print it twice, whoever writes the
 * next one.
 */
const fullTitle =
  exactTitle || title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;

/**
 * Apple's Smart App Banner, on every page, while the app is on sale — the
 * штаб's decision of 13.09.2026. Safari on iPhone and iPad draws a strip at
 * the top of the page with a View or Open button; Apple's documentation says
 * it only appears where the device supports the app and the app is sold in
 * the visitor's country. The ID is read out of `RELEASE.appStoreUrl` rather
 * than typed a second time, so the banner and the buttons cannot point at two
 * different apps. /privacy says that it exists, because drawing it is Safari
 * checking with the App Store.
 */
const appStoreId = RELEASE.appStoreUrl?.match(/\/id(\d+)/)?.[1];

/**
 * SPEC §6. While the site lives on the temporary Pages address, *every* page
 * carries `noindex` — not because these pages are unfit to be found, but
 * because the address is. `nofollow` goes with it while temporary: there is
 * nothing to be gained by having a crawler walk a site it may not index, and
 * links from a throwaway host are not links we want counted.
 *
 * `INDEXABLE` comes from the one switch in src/consts.ts, and the build fails
 * if a rendered page disagrees with it (src/build/hq-guards.ts).
 */
const robots = !INDEXABLE
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      showAlternates &&
        alternates.map((entry) => (
          <link
            rel="alternate"
            hreflang={entry.lang}
            href={new URL(entry.path, Astro.site).href}
          />
        ))
    }
    {
      showAlternates && xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault.path, Astro.site).href}
        />
      )
    }
    {robots && <meta name="robots" content={robots} />}
    {
      RELEASE.state === 'released' && appStoreId && (
        <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#14161F"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#F7F8FB"
      media="(prefers-color-scheme: light)"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_TAGS[lang].replace('-', '_')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {INDEXABLE && <link rel="sitemap" href="/sitemap-index.xml" />}

    <!-- Pages that need a tag of their own put it here. -->
    <slot name="head" />

    {
      schema.map((entry) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(entry)}
        />
      ))
    }
  </head>

  <body>
    <a class="skip-link" href="#main">{ui('skipLink')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
  </body>
</html>
