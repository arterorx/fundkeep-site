---
import Base from '../layouts/Base.astro';
import AppStoreCta from '../components/AppStoreCta.astro';
import Screenshot from '../components/Screenshot.astro';
import { PRICING, RELEASE, SITE, TRIAL } from '../consts';

/**
 * The home page (SPEC §4, phase 2). It carries the five things that phase
 * asks for and nothing else: the promise, the board, the price, the
 * platforms, and privacy.
 *
 * What a reader has to leave with (SPEC §3): the same method, paid for once,
 * and the data stays theirs. What the reader is (SPEC §2): somebody who
 * already knows the method — so nothing here explains what a budget is, and
 * nothing tells anyone what to do with their money.
 *
 * Every claim below is checkable against the app or its store metadata.
 * Deliberately absent: quick entry from the widget, Control Centre, Siri and
 * Spotlight. It is built, but its rendering in the widget gallery has not been
 * verified by hand yet, and SPEC §5 does not allow the site to describe a
 * feature nobody has watched work. It goes in when it has been.
 */

const description = SITE.description;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    applicationCategory: 'FinanceApplication',
    operatingSystem: RELEASE.requires,
    url: SITE.url,
    description,
    offers: {
      '@type': 'Offer',
      price: PRICING.full.replace('$', ''),
      priceCurrency: 'USD',
      // One payment. Not a subscription, and the markup says so too.
      category: 'one-time purchase',
    },
  },
];

/** The method, in the order money actually moves through it. */
const steps = [
  {
    title: 'Money arrives',
    body: 'It lands in To Be Assigned, and the board says plainly that it has no job yet.',
  },
  {
    title: 'You give it a job',
    body: 'Assign it across your envelopes until To Be Assigned reaches zero. Each envelope then shows what is left in it, not what you hoped to spend.',
  },
  {
    title: 'You spend it',
    body: 'The envelope falls by what you spent. Overspend one and Fundkeep says so plainly, then carries the rest forward the way the method expects.',
  },
];
---

<Base title={SITE.name} description={description} schema={schema}>
  <!-- The board is the largest thing above the fold, so it is what Largest
       Contentful Paint measures. Without this the browser only learns it
       exists after the HTML is parsed. `imagesizes` has to match the img's
       own `sizes` exactly, or the two disagree and the file is fetched
       twice. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/screens/board-360.webp"
    imagesrcset="/screens/board-360.webp 360w, /screens/board-720.webp 720w"
    imagesizes="300px"
    fetchpriority="high"
  />
  <!-- ---------------------------------------------------------------- Hero -->
  <section class="section wrap hero">
    <div class="hero__text">
      {/* 1. What it is, and how it works. The heading is deliberately two
           words: on a 360×640 phone the platform list pushed it to four lines
           and drove the price off the first screen, which is the one thing
           this order exists to prevent. The platforms belong in the sentence
           that follows anyway. */}
      <h1>Envelope budgeting</h1>
      <p class="lede">
        You decide what every dollar is for before you spend it, on {
          RELEASE.platforms
        }. The board shows what is genuinely left — not what you meant to spend.
      </p>

      {/* 2. What it does not do to you. Kept to two clauses: the CSV export is
           true and it is said twice further down, and this line has to stay
           short enough that the price and the button both survive on a 375×667
           screen. */}
      <p class="promise">
        No subscription, no account, no bank login. Your budget stays on your own
        devices.
      </p>

      {/* 3. The price, plainly and on this screen — never below the fold. */}
      <p class="price-line">
        <strong>{PRICING.full}</strong>{' '}
        <span class="muted"
          >— {PRICING.note}. Free for the first {TRIAL.days} days, with nothing
          withheld.</span
        >
      </p>

      {/* 4. The way in. */}
      <AppStoreCta class="hero__cta" />
    </div>

    <div class="hero__shot">
      <Screenshot
        name="board"
        priority
        sizes="300px"
        alt="The Fundkeep board for August 2026. A card at the top reads To Be Assigned, $670.00, with Assign and Add Income buttons. Below it the envelopes: Rent, $0.00 left of $1,600.00 assigned; Electric, $1.45 left of $90.00."
      />
    </div>
  </section>

  <!-- -------------------------------------------------------------- Method -->
  <section class="section wrap">
    <h2>Money gets a job before it gets spent</h2>
    <p class="lede">
      The board is the whole app in one screen: what is still unassigned at the
      top, and what is genuinely left in each envelope underneath.
    </p>

    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="note">
      Credit cards work the way the method needs them to: a card purchase moves
      money into that card's payment envelope, so it is set aside the moment you
      spend it rather than the moment the bill lands.
    </p>
  </section>

  <!-- --------------------------------------------------------------- Moving -->
  <section class="section wrap">
    <div class="column">
      <h2>Bringing a budget with you</h2>
      <p>
        Coming from YNAB, or from anything else that exports: Fundkeep reads the
        export, rebuilds your categories, accounts and history, and then shows
        you a reconciliation report — what the other app said each balance was,
        what Fundkeep makes it, and every difference it found. You check the
        numbers before you commit to them.
      </p>
      <p>
        Your bank's own CSV works the same way. Fundkeep works out the columns
        itself for the layouts the major US banks produce, shows you every row
        before anything is saved, and importing the same file twice duplicates
        nothing.
      </p>
    </div>
  </section>

  <!-- -------------------------------------------------------------- Screens -->
  <section class="section wrap">
    <h2>Two more screens</h2>
    <div class="screens">
      <figure>
        <Screenshot
          name="newspend"
          sizes="300px"
          alt="The New Spend sheet: an amount of 24.50 in red, a Spending and Income switch, a payee field with suggestions, and envelope chips showing Fun with $145.55 left, Groceries with $521.22 left and Dining Out with $254.25 left."
        />
        <figcaption>
          Entering a spend takes seconds, and the envelope chips show what is
          left in each one before you pick.
        </figcaption>
      </figure>

      <figure>
        <Screenshot
          name="reports"
          sizes="300px"
          alt="The Reports screen for August 2026: a summary of what was spent and how old the money was, then a bar chart of where the month went, led by Rent at $1,600.00."
        />
        <figcaption>
          Reports state facts about your own history — where the month went, how
          it compares with the last three, how old the money you spent was. Every
          figure is a statement about your figures. The app never tells you what
          to do with your money.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Platforms -->
  <section class="section wrap">
    <div class="column">
      <h2>{RELEASE.platforms}</h2>
      <p>
        One purchase covers all three. It needs {RELEASE.requires} or later.
      </p>
      <p>
        The Mac app is a real Mac app, with a menu bar and keyboard shortcuts,
        rather than a phone app in a window. Your devices stay in step through
        your own private iCloud, and you can switch that off.
      </p>
    </div>
  </section>

  <!-- -------------------------------------------------------------- Privacy -->
  <section class="section wrap">
    <div class="column">
      <h2>No bank logins. No server. Nothing to leak.</h2>
      <p>
        Fundkeep never asks for a bank login, and that is deliberate rather than
        pending — there is no Plaid or equivalent in it. Transactions arrive two
        ways: you type them, or you pick a CSV you exported from your own bank,
        and it is read on the device.
      </p>
      <p>
        There is no account, no analytics, no crash reporting and no third-party
        code of any kind. On the App Store that shows up as the <strong
          >Data Not Collected</strong
        > label. Everything exports to CSV whenever you want it, including after
        the trial ends — an app that held your own records hostage would not be worth
        trusting with them.
      </p>
      <p>
        <a href="/privacy">The full privacy policy</a> sets out what is stored,
        what is sent and to whom.
      </p>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- Price -->
  <section class="section wrap">
    <div class="column">
      <h2>{PRICING.full}, once</h2>
      <p class="lede">
        Free for {TRIAL.days} days with every feature working. After that the app
        becomes read-only until you buy it: what you entered stays visible, and
        exporting keeps working. Nothing renews, because there is nothing to
        renew.
      </p>
      <AppStoreCta />
    </div>
  </section>
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    /* Tighter than the other sections on a phone, and for one reason: the
       price and the button have to stay on the first screen down to 360×640.
       Measured, not guessed — see the note by .price-line. */
    padding-block: var(--space-l) var(--space-2xl);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr minmax(260px, 320px);
      gap: var(--space-3xl);
      padding-block: var(--space-3xl);
    }
  }

  .hero__text > :last-child {
    margin-bottom: 0;
  }

  .hero__shot {
    /* On a phone the screenshot is an illustration, not the point; full width
       would push the price and the status line off the first screen. */
    max-width: 300px;
    margin-inline: auto;
    width: 100%;
  }

  /* The second beat: what it does not do to you. Set apart from the method
     above it so the two read as separate answers rather than one long
     paragraph. */
  .promise {
    max-width: var(--measure);
    margin-top: var(--space-s);
    padding-left: var(--space-m);
    border-left: 2px solid var(--rule);
    color: var(--text-muted);
  }

  /* The price is deliberately still on the first screen. Somebody who hates
     subscriptions wants to see a one-time figure immediately — a hidden price
     puts them off harder than a high one. The change was to put it after the
     two lines that make it make sense, not to move it out of sight. */
  .price-line {
    font-size: var(--step-1);
    margin-top: var(--space-s);
  }

  @media (min-width: 48rem) {
    .price-line {
      margin-top: var(--space-l);
    }
  }

  .price-line strong {
    font-weight: 700;
  }

  .hero__cta {
    margin-top: var(--space-m);
  }

  @media (min-width: 48rem) {
    .hero__cta {
      margin-top: var(--space-l);
    }
  }

  /* --- Steps ------------------------------------------------------------- */

  .steps {
    display: grid;
    gap: var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  .steps li {
    margin-top: 0;
    padding-top: var(--space-m);
    border-top: 2px solid var(--text-accent);
    counter-increment: step;
  }

  .steps h3 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
    font-size: var(--step-1);
  }

  .steps h3::before {
    content: counter(step) '. ';
    color: var(--text-accent);
  }

  .steps p {
    margin: 0;
    color: var(--text-muted);
  }

  .note {
    max-width: var(--measure);
    margin-top: var(--space-xl);
    color: var(--text-muted);
  }

  /* --- Screens ----------------------------------------------------------- */

  .screens {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .screens {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2xl) var(--space-3xl);
    }
  }

  .screens figure {
    margin: 0;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    /* Without this the shorter figure is stretched to its neighbour's height
       and the leftover space is shared out between its rows, so its caption
       floats away from its screenshot and the two columns stop lining up. */
    align-content: start;
  }

  .screens :global(.screenshot) {
    max-width: 300px;
  }

  .screens figcaption {
    color: var(--text-muted);
    max-width: 42ch;
  }
</style>
