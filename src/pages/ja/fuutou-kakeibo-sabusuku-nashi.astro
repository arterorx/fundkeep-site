---
import Base from '../../layouts/Base.astro';
import AppStoreCta from '../../components/AppStoreCta.astro';
import { MARKETS, SITE, YNAB } from '../../consts';
import { LEAVING_YNAB, noSubscriptionCluster, YNAB_PRICING } from '../../i18n/pages';

/**
 * 封筒式の家計簿アプリがなぜサブスクばかりなのか。
 * 日本語版では、月額の最大の中身である銀行連携がそもそも日本で効かない、
 * という事実を最後に置く——英語版にはない結論になる。
 */

const lang = 'ja' as const;
const m = MARKETS[lang];

const title = 'サブスクなしの封筒家計簿：月額は何を買っているのか';
const description =
  'この種のアプリがほぼすべてサブスクなのはなぜか、月額が実際に買っているもの、そしてやめたときに何が変わるのか。';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'ja',
    datePublished: '2026-09-26',
    dateModified: '2026-09-26',
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: `${SITE.url}/ja/fuutou-kakeibo-sabusuku-nashi`,
  },
];
---

<Base
  title={title}
  exactTitle
  description={description}
  schema={schema}
  lang={lang}
  alternates={noSubscriptionCluster()}
>
  <meta slot="head" name="fundkeep:competitor-prices" content="yes" />

  <section class="section wrap">
    <div class="column">
      <p class="eyebrow">記事</p>
      <h1>サブスクなしの封筒家計簿</h1>
      <p class="lede">
        方法のほうがソフトウェアより古い。サブスクは何か具体的なものを買って
        います。それが欲しいかを決める前に、何を買っているのかを知る価値が
        あります。
      </p>
      <p>
        封筒式の家計管理は製品ではありません。100年前からある習慣です。使う
        <strong>前</strong>に、そのお金が何のためかを決め、そのためにしか
        使えない場所に置き、封筒が空になったら空。誰かが月額を請求するよりずっと
        前から、人は現金と紙の封筒でそれをしていました。
      </p>
      <p>
        だとすれば、それをきちんとやるアプリがほぼ全部サブスクなのはなぜか、
        という問いは当然です。答えは強欲ではありません。そして理解しておく価値が
        あります。払うのをやめたとき何を手放すことになるのかが、そこに正確に
        書いてあるからです。
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>月額が実際に買っているもの</h2>
      <p>おおよそ費用の大きい順に、三つです。</p>
      <p>
        <strong>銀行との接続。</strong>これが最大の項目です。アプリが自分で
        銀行につなぐのではなく、アグリゲーターに金を払ってつないでもらいます。
        アグリゲーターは接続口座ごとに、毎月、ずっと課金します。しかもこの接続は
        絶えず壊れます。銀行はログインの流れを変え、認証の手順を足し、サイトを
        作り直します。誰かが直し続けなければなりません。継続的な費用は、継続的な
        収入で払うしかありません。逃げ道はありません。
      </p>
      <p>
        <strong>サーバー。</strong>家計がサインインするアカウントの中にあるなら、
        誰かが保管と backup と、止まったときに叩き起こされる人の費用を
        払っています。
      </p>
      <p>
        <strong>開発の継続。</strong>本当の費用ですが、三つの中ではたいてい
        いちばん小さく、そして他の二つを正当化するのに最もよく使われます。
      </p>
      <p>
        最初の二つを取り除くと、採算の形が変わります。銀行接続も自前のサーバーも
        持たないアプリの費用は、サービスではなくソフトウェアの費用に見えます。
        だから、ソフトウェアのように売ることができます。
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>失うもの</h2>
      <p>
        便利さについては、すべてです。これが正直な交換条件で、うまい抜け道は
        ありません。
      </p>
      <p>
        銀行接続がなければ、取引は勝手には現れません。自分で入力するか——1件
        数秒で、むしろそこが要点だと感じる人もいます。金額を打つ瞬間が、それに
        気づく瞬間だからです——都合のいいときに銀行から CSV を書き出して、
        まとめて取り込みます。
      </p>
      <p>
        アプリが残高を知っている、という状態も失います。アプリが知っているのは
        <em>あなたが</em>教えたことだけです。打ち間違えた数字は、明細と
        突き合わせるまで間違ったままです。それは今後、やってもらうことではなく、
        自分で意識してやることになります。
      </p>
      <p>本当の代償です。そうでないと言う人は、何かを売っています。</p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>得るもの</h2>
      <p>
        <strong>あなたの口座の鍵を誰も持ちません。</strong>銀行接続とは、第三者が
        あなたの取引履歴に対して継続的な読み取り権を持つということで、その権利は
        盗む価値があります。接続がなければ、盗むものがなく、漏れるものもなく、
        あとから「匿名化した支出データ」は商売になると決める会社もありません。
      </p>
      <p>
        <strong>払うのをやめても家計簿は止まりません。</strong>ここが最も驚かれる
        点です。サブスクが切れたとき、何年分もの入力はどうなるのか。読み取り専用に
        なることもあれば、書き出しだけになることも、消えることもあります。いま
        使っているものについて、その答えを読んでおく価値があります。答えはどこかに
        必ずあり、たいてい価格ページにはありません。
      </p>
      <p>
        <strong>計算が変わります。</strong>サブスクは何度も繰り返す判断で、買い切りは
        一度きりの判断です。意味のある長さで見れば差は小さくありません。
        {YNAB.name} は {m.ynabYear}／年、{SITE.name} は {m.full} を一度。
        <a href={`/${lang}/${YNAB_PRICING[lang]}`}>スライダーで実際の数字を出せます</a>。
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>買い切りへの、答えにくい質問</h2>
      <p>一度しか払わないなら、開発者は何のために作り続けるのか。</p>
      <p>
        正直な答えは「新しい利用者のため」です。それがこの模型です。アプリは
        勧められるだけの出来を保たねばならず、いつかは新しいメジャー版がもう一度
        買う価値のあるものでなければなりません。サブスク以前のソフトウェアは
        たいていこう売られていて、この模型には分かりやすい壊れ方があります。
        静かに見捨てられるアプリです。
      </p>
      <p>
        その備えは約束ではありません。約束はただだからです。備えは、止める
        スイッチがどこにもないことです。サーバーを持たないアプリは、会社が興味を
        失っても動き続けます。あなたの端末の上で、あなたのデータとともに、
        いつでも CSV に書き出せる状態で。安心させる答えではなく、構造の答えで、
        構造は確かめられます。
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>方法そのものは今も使えるのか</h2>
      <p>
        まったく変わりません。すべてのお金に役割を与え、未割り当てをゼロに保ち、
        使うつもりだった額ではなく封筒に残っている額を見て、使いすぎたら別の封筒
        から差額を移してそれを感じる。クレジットカードは正しく扱う必要があります
        ——使った時点でカードの支払い用封筒へお金が移り、請求が来る前に取り分けられ
        ます——が、それは方法の細部であって、サブスクの話ではありません。
      </p>
      <p>
        どれも銀行接続を必要としません。もともと必要ではなかったのです。接続は
        便利さであって、方法と一緒に売られ続けた結果、二つが一つに見えるように
        なっただけです。
      </p>
      <p>
        <strong>日本ではその区別がさらにはっきりします。</strong>{YNAB.name} の
        直接取り込みの対象は米国・カナダ・英国・EU の一部の銀行で、日本の銀行は
        入っていません。つまり月額の最大の中身は、ここでは最初から働きません。
        残るのは金額の話だけです。
        <a href={`/${lang}/${LEAVING_YNAB[lang]}`}>乗り換えで実際に何が起きるか</a>
        は隣のページにあります。
      </p>
      <AppStoreCta lang={lang} />
    </div>
  </section>
</Base>
