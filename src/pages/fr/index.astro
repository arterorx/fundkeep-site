---
import Base from '../../layouts/Base.astro';
import AppStoreCta from '../../components/AppStoreCta.astro';
import { MARKETS, MARKETS_CHECKED, RELEASE, SITE, TRIAL, YNAB } from '../../consts';
import { BOUGHT_ONCE, homeCluster } from '../../i18n/pages';

/**
 * La page d'accueil française. Les montants sont ceux de l'App Store français
 * (MARKETS.fr) : Apple fixe un prix par région, et convertir le prix américain
 * donnerait un chiffre faux dans une monnaie que le lecteur ne paie pas.
 */

const lang = 'fr' as const;
const m = MARKETS[lang];

const title = `${SITE.name} — Budget par enveloppes pour iPhone, iPad et Mac, acheté une fois`;
const description = `La méthode des enveloppes sur iPhone, iPad et Mac. ${m.full} une fois, sans abonnement, sans identifiants bancaires. Votre budget reste sur vos appareils.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    applicationCategory: 'FinanceApplication',
    operatingSystem: RELEASE.requires,
    url: `${SITE.url}/fr`,
    inLanguage: 'fr',
    description,
    offers: [
      {
        '@type': 'Offer',
        name: `Téléchargement gratuit, ${TRIAL.days} jours d’essai`,
        price: '0',
        priceCurrency: 'EUR',
      },
      {
        '@type': 'Offer',
        name: `${SITE.name} Full`,
        price: m.full.replace(/[^\d,]/g, '').replace(',', '.'),
        priceCurrency: 'EUR',
        category: 'one-time purchase',
      },
    ],
    ...(RELEASE.appStoreUrl ? { downloadUrl: m.storeUrl, installUrl: m.storeUrl } : {}),
  },
];
---

<Base
  title={title}
  exactTitle
  description={description}
  schema={schema}
  lang={lang}
  alternates={homeCluster()}
>
  <meta slot="head" name="fundkeep:competitor-prices" content="yes" />

  <section class="section wrap">
    <div class="column">
      <p class="eyebrow">Budget par enveloppes</p>
      <h1>Chaque euro reçoit une tâche. Payé une seule fois.</h1>
      <p class="lede">
        {SITE.name}, c'est la méthode des enveloppes sur iPhone, iPad et Mac :{' '}
        <strong>{m.full} une fois</strong>, sans abonnement et sans identifiants
        bancaires. Ce que vous saisissez reste sur vos appareils et ne circule,
        via iCloud, qu'entre les vôtres.
      </p>
      <AppStoreCta lang={lang} />
      <p class="small muted">
        Gratuit les {TRIAL.days} premiers jours. Ensuite l'app passe en lecture
        seule : tout ce que vous avez saisi reste visible et l'export CSV
        continue de fonctionner.
      </p>
    </div>

  </section>

  <section class="section wrap">
    <div class="column">
      <h2>Ce qu'un abonnement coûte pendant le même temps</h2>
      <p>
        Sur l'App Store français, {YNAB.name} coûte <strong>{m.ynabYear}</strong>{' '}
        par an, ou {m.ynabMonth} par mois. {SITE.name} coûte {m.full}, une fois.
        L'achat est amorti en un peu plus de quatre mois d'abonnement ; tout ce
        qui suit est la différence.
      </p>
      <p class="small muted">
        Les deux montants viennent des fiches App Store elles-mêmes, relevées le{' '}
        <time datetime={MARKETS_CHECKED.on}>{MARKETS_CHECKED.display.fr}</time>.
      </p>
      <p>
        <a href={`/${lang}/${BOUGHT_ONCE[lang]}`}
          >Les applications de budget sans abonnement, avec leurs prix</a
        > — et les cas où « achat unique » veut dire chaque année.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>Aucune connexion bancaire. Ce n'est pas une fonction manquante.</h2>
      <p>
        {SITE.name} ne demande pas vos identifiants bancaires parce qu'il n'en a
        pas besoin : vous saisissez vos dépenses, ou vous importez le fichier
        CSV que votre banque fournit déjà. Si c'est précisément ce que vous
        vouliez éviter, un abonnement est la réponse honnête, et ce n'est pas
        nous.
      </p>
      <p>
        Pas de compte, pas d'inscription, aucun serveur chez nous. Les données
        vivent dans votre propre iCloud, et ce qui s'y trouve, nous ne pouvons
        pas le lire.
      </p>
      
    </div>
  </section>
  <section class="section wrap">
    <div class="column">
      <h2>L'argent reçoit une tâche avant d'être dépensé</h2>
      <p class="lede">
        Le tableau, c'est toute l'application en un écran : en haut ce qui n'est
        pas encore affecté, en dessous ce qui reste vraiment dans chaque
        enveloppe.
      </p>
      <ol class="steps">
        <li>
          <h3>L'argent arrive</h3>
          <p>
            Il se pose dans « à affecter », et le tableau dit clairement qu'il
            n'a pas encore de tâche.
          </p>
        </li>
        <li>
          <h3>Vous lui donnez une tâche</h3>
          <p>
            Répartissez-le entre vos enveloppes jusqu'à ce que « à affecter »
            tombe à zéro. Chaque enveloppe montre alors ce qui lui reste, pas ce
            que vous espériez dépenser.
          </p>
        </li>
        <li>
          <h3>Vous le dépensez</h3>
          <p>
            L'enveloppe baisse du montant dépensé. Si vous la passez en négatif,
            Fundkeep le dit clairement et reporte le reste comme la méthode le
            prévoit.
          </p>
        </li>
      </ol>
      <p class="note">
        Les cartes de crédit fonctionnent comme la méthode l'exige : un achat par
        carte déplace l'argent vers l'enveloppe de paiement de cette carte — il
        est donc mis de côté au moment de la dépense, et non à l'arrivée de la
        facture.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>iPhone, iPad et Mac</h2>
      <p>
        Un seul achat couvre les trois. Il faut {RELEASE.requires} ou une
        version plus récente. L'app Mac est une vraie app Mac, avec barre de
        menus et raccourcis clavier, pas une app de téléphone dans une fenêtre.
        Vos appareils restent alignés via votre propre iCloud privé, et vous
        pouvez désactiver cela.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <div class="column">
      <h2>{m.full}, une fois</h2>
      <p>
        Pas d'abonnement, aucune formule au-dessus, aucun compte à maintenir en
        vie. Tout s'exporte en CSV à tout moment, y compris après l'essai et
        avant tout achat — une application qui retiendrait vos propres écritures
        ne mériterait pas qu'on les lui confie.
      </p>
      <AppStoreCta lang={lang} variant="text" />
    </div>
  </section>
</Base>
