---
import Base from '../layouts/Base.astro';
import AppStoreCta from '../components/AppStoreCta.astro';
import Screenshot from '../components/Screenshot.astro';
import {
  PRICING,
  RELEASE,
  SITE,
  TRIAL,
  YNAB,
  monthsCovered,
} from '../consts';

/**
 * The page SPEC §4 says the site exists for.
 *
 * Discovery is the app's main risk: people leaving YNAB search, they do not
 * browse the App Store. This is where they land, so it has to answer the
 * three things SPEC §2 says they actually want to know — will I lose my data,
 * does the method work the same, what does it cost — and it has to be honest
 * about what they give up, because a page that only lists wins reads as an
 * advertisement and gets closed.
 *
 * YNAB is named here, and only here and in the articles, never in the app
 * (SPEC §5). The prices are constants that were read off ynab.com/pricing on
 * YNAB.checkedOn; the build warns when they are due a re-read and refuses any
 * figure on this page that its own arithmetic cannot produce.
 */

const title = `${YNAB.name} alternative`;
const description = `Fundkeep is envelope budgeting for iPhone, iPad and Mac, bought once for ${PRICING.full} instead of ${YNAB.price} ${YNAB.period}. Same method, no bank logins.`;

/**
 * The headline figure, and the reason this page is shaped the way it is.
 *
 * Штаб, 17.08.2026: the price is no longer held up by anything on the App
 * Store shelf. We are the most expensive one-time purchase in the visible
 * category, next to Envy at a fraction of it and a row of free apps. What
 * holds the price is where the reader arrived from — somebody who searched
 * "ynab alternative" is already carrying a yearly figure in their head, and
 * against that this is obviously cheap. So the first thing on the page is
 * their arithmetic, not our promise.
 */
const months = monthsCovered();
const monthsDisplay = months.toFixed(1);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${title} — ${SITE.name}`,
    description,
    url: `${SITE.url}/ynab-alternative`,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
];

/** What is the same, and what is not. Both lists are the honest ones. */
const same = [
  'Give every dollar a job. Money that arrives sits in To Be Assigned until you have given all of it somewhere to be.',
  'Envelopes hold what is left, not what you hoped to spend.',
  'Overspend an envelope and the app says so, then carries the rest forward the way the method expects.',
  'Credit cards move money into the card’s payment envelope as you spend, so it is set aside before the bill lands.',
  'A month is a month. You move between them and each keeps its own assignments.',
];

const different = [
  {
    title: 'No bank connections',
    body: 'This is the big one, and it is deliberate rather than unfinished. Fundkeep will not fetch your transactions for you. You type them, or you export a CSV from your bank and pick that file. In exchange there is no bank login to hand over, no third party holding a read-only key to your accounts, and nothing to breach.',
  },
  {
    title: 'Apple devices only',
    body: `${RELEASE.platforms}, and no web app. If you budget from a Windows machine at work, this is not the app for you.`,
  },
  {
    // Until 13.09.2026 this item said "No targets or goals in this version",
    // which stopped being true with 1.2 ("Give an envelope a monthly goal —
    // how much to put in each month — and see what is still missing", the App
    // Store release notes). The wording below is the штаб's. Its three YNAB
    // examples were checked against YNAB's help pages the same day: targets
    // repeat "Weekly, Monthly, Yearly, or Custom", can "Refill up to...", and
    // "Have a balance of..." can carry a due date.
    title: 'Simpler goals than YNAB’s targets',
    body: 'Fundkeep gives an envelope a monthly goal — how much to put in each month, and what is still missing. YNAB’s targets do more (by a date, refill up to, weekly); if you lean on those, that is a real difference.',
  },
  {
    title: 'One person’s devices',
    body: 'Your own iPhone, iPad and Mac stay in step through your private iCloud. Sharing a budget with somebody else is not in this version.',
  },
];
---

<Base title={title} description={description} schema={schema}>

  <!-- ------------------------------------------------- Their arithmetic -->
  <section class="section wrap">
    <div class="column">
      <p class="eyebrow">Leaving {YNAB.name}?</p>
      <h1>{YNAB.price} {YNAB.period}, or {PRICING.full} once</h1>
      <p class="lede">
        You already know the first number — it leaves your account every year,
        whether or not you opened the app. Here is what the second one does to
        it.
      </p>
    </div>

    <p class="headline-stat">
      One purchase costs what your subscription costs in{' '}
      <strong>{monthsDisplay} months</strong>.
    </p>

    {
      /* The calculator lived here until 13.09.2026. The штаб moved it to
         /ynab-pricing, the page for people asking what YNAB costs, and this
         link is what it left behind. */
    }
    <p class="calculator-link">
      <a href="/ynab-pricing"
        >Work out what {YNAB.name} costs over the years you expect to keep
        budgeting</a
      >, and see every price it has charged since YNAB 4.
    </p>

    <div class="column">
      <p class="small muted">
        {YNAB.name}'s prices are the ones published at{' '}
        <a href={YNAB.source}>ynab.com/pricing</a>, read there on{' '}
        <time datetime={YNAB.checkedOn}>{YNAB.checkedOnDisplay}</time>, before
        tax. The months figure uses their cheaper annual billing.{' '}
        {PRICING.full} is what Fundkeep costs today, and it buys this version of
        the app outright.
      </p>
    </div>

    <div class="column">
      <AppStoreCta class="hero__cta" />
    </div>
  </section>

  <!-- ---------------------------------------------------------- What's same -->
  <section class="section wrap same">
    <div class="same__text">
      <h2>What works the same</h2>
      <p>
        The method is the method — it is older than either app, and Fundkeep
        does not have a clever reinterpretation of it.
      </p>
      <ul class="ticks">
        {same.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="same__shot">
      <Screenshot
        name="board"
        sizes="300px"
        alt="The Fundkeep board for August 2026, showing $670.00 still to be assigned above a list of envelopes with what is left in each."
      />
    </div>
  </section>

  <!-- ----------------------------------------------------- What you give up -->
  <section class="section wrap">
    <div class="column">
      <h2>What you give up</h2>
      <p>
        Worth knowing before you spend anything, and worth knowing that we told
        you rather than letting you find out.
      </p>
    </div>

    <ul class="gives">
      {
        different.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- --------------------------------------------------------- Moving over -->
  <section class="section wrap">
    <div class="column">
      <h2>Bringing your budget across</h2>
      <p>
        Fundkeep reads a {YNAB.name} export and rebuilds your categories,
        accounts and history from it. Then — and this is the part that matters —
        it shows you a <strong>reconciliation report</strong> before you commit
        to any of it: what {YNAB.name} said each balance was, what Fundkeep makes
        it, and every difference it found.
      </p>
      <p>
        You are not asked to trust an importer. You are asked to read a list of
        differences and decide. If the numbers do not agree, nothing has been
        saved and you have lost an afternoon rather than a budget.
      </p>
      <p>
        Your own data stays yours on the way out, too: everything exports to CSV
        at any time, including after the {TRIAL.days}-day trial ends and before
        you have bought anything.
      </p>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- Price -->
  <section class="section wrap">
    <div class="column">
      <h2>{PRICING.full}, once</h2>
      <p class="lede">
        Free for {TRIAL.days} days with every feature working — {YNAB.name} gives
        you {YNAB.trialDays} when you sign up on its own site, so you can run both
        and see. After the trial
        Fundkeep becomes read-only until you buy it: what you entered stays
        visible, and exporting keeps working.
      </p>
      {/* Text, not a second badge: Apple allows one per layout. */}
      <AppStoreCta variant="text" />
    </div>
  </section>
</Base>

<style>
  /* --- Their arithmetic, first ------------------------------------------- */

  /* The one line the page is built around. Big enough to be the first thing
     read, and it is a statement about the reader's own bank statement rather
     than about us. */
  .headline-stat {
    /* Not `var(--measure)`: that is 68ch, and ch grows with the font size, so
       at this size the block ran wider than the heading and the calculator it
       sits between. A rem width keeps the three left edges and right edges in
       one column. */
    max-width: 45.5rem;
    margin: var(--space-xl) 0 0;
    padding: var(--space-l);
    background: var(--surface-sunk);
    border-left: 3px solid var(--text-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--step-2);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .headline-stat strong {
    color: var(--text-accent);
    white-space: nowrap;
  }

  .hero__cta {
    margin-top: var(--space-l);
  }

  /* --- The method, with the board beside it ------------------------------ */

  .same {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .same {
      grid-template-columns: 1fr minmax(240px, 300px);
      gap: var(--space-3xl);
    }
  }

  .same__text {
    max-width: var(--measure);
  }

  .same__shot {
    max-width: 300px;
    margin-inline: auto;
    width: 100%;
  }

  .calculator-link {
    max-width: var(--measure);
    margin: var(--space-m) 0 var(--space-l);
  }

  /* --- Lists ------------------------------------------------------------- */

  .ticks {
    padding-left: 0;
    list-style: none;
  }

  .ticks li {
    padding-left: 1.6em;
    position: relative;
    margin-top: var(--space-s);
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 0.55em;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--text-accent);
  }

  .gives {
    display: grid;
    gap: var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .gives {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  .gives li {
    margin-top: 0;
    padding-top: var(--space-m);
    border-top: 2px solid var(--border-strong);
  }

  .gives h3 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
    font-size: var(--step-1);
  }

  .gives p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
