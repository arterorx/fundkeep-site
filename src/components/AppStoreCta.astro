---
import { MARKETS, RELEASE } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

/**
 * The way to the App Store — or the truth, while there is nothing to link to.
 *
 * SPEC §3 puts a store button on the first screen. It reads `RELEASE`, so the
 * button and the status line cannot both be wrong in different places: before
 * 2 September 2026 this rendered "Not on the App Store yet", and switching
 * `state` and `appStoreUrl` in src/consts.ts turned every copy of it into a
 * link at once. The build fails if a released call to action renders without
 * the link inside it.
 *
 * TWO VARIANTS, BECAUSE APPLE ALLOWS ONE BADGE. Apple's marketing guidelines
 * say "Use one App Store badge per layout". The home page and /ynab-alternative
 * each ask for a call to action twice, so the first one on a page is Apple's
 * badge and any later one is the text button. The build counts badges and
 * fails a page that shows two.
 *
 * The badge is Apple's own artwork, byte for byte: the black "Download on the
 * App Store", English, from the Fundkeep page of Apple's App Store Marketing
 * Tools (download-on-the-app-store-en-us.zip, `black.svg`, 10,804 bytes),
 * fetched on 13.09.2026 and served from public/badges/ — never hotlinked,
 * because the site makes no request to anybody else's server (SPEC §9), and
 * the CSP would block it anyway. The same guidelines say not to modify, angle
 * or animate it, so it has no hover effect. They also ask for a height of at
 * least 40 px onscreen, held below, and clear space of a quarter of its height,
 * which depends on where it is placed and is checked on the page.
 *
 * The text label is Apple's wording too, the words on the badge. "Get it on"
 * is Google Play's phrase.
 *
 * FOUR BADGES, ONE SOURCE. Apple publishes the badge in each language, and
 * the guidelines ask for the one that matches the page. The German, French
 * and Japanese files were fetched on 26.09.2026 from the same place as the
 * English one — toolbox.marketingtools.apple.com — and the English file that
 * came back was byte for byte the one already in public/badges/, which is how
 * we know the other three are the same artwork and not somebody's copy. Their
 * intrinsic widths differ (the German wordmark is shorter than the French
 * one), so each carries its own, or the browser reserves the wrong box and
 * the page shifts as it loads.
 */
const BADGES: Record<Locale, { file: string; width: number }> = {
  en: { file: '/badges/app-store-black.svg', width: 120 },
  de: { file: '/badges/app-store-black-de.svg', width: 120 },
  fr: { file: '/badges/app-store-black-fr.svg', width: 127 },
  ja: { file: '/badges/app-store-black-ja.svg', width: 109 },
};
interface Props {
  class?: string;
  /** `badge` for the first call to action on a page, `text` for any after it. */
  variant?: 'badge' | 'text';
  /** The page's language: picks Apple's badge and the right storefront. */
  lang?: Locale;
}

const { class: className, variant = 'badge', lang = DEFAULT_LOCALE } = Astro.props;
const ui = t(lang);
const badge = BADGES[lang];
/* A reader on the German page goes to the German storefront. Apple forwards
   people to their own country either way, but the localised address is the
   one whose price matches the price this page just printed. */
const href = lang === DEFAULT_LOCALE ? RELEASE.appStoreUrl : MARKETS[lang].storeUrl;
---

<div class:list={['cta', className]}>
  {
    RELEASE.state === 'released' && RELEASE.appStoreUrl ? (
      variant === 'badge' ? (
        <a class="cta__badge" href={href}>
          <img
            src={badge.file}
            alt={ui('cta.badgeAlt')}
            width={badge.width}
            height="40"
          />
        </a>
      ) : (
        <a class="cta__button" href={href}>
          {ui('cta.badgeAlt')}
        </a>
      )
    ) : (
      <p class="cta__status">
        <strong>{RELEASE.status}.</strong> No date is promised here, because a
        date would be a guess — App Review sets it.
      </p>
    )
  }
</div>

<style>
  /* 48 px tall: over Apple's 40 px minimum, and seven pixels shorter than the
     text button it replaced, which is what keeps the first screen of the home
     page intact at 360×640. `width: auto` lets the file's own proportions win
     once it loads, so the artwork is never stretched; the width and height
     attributes only reserve the space before it arrives. */
  /* No padding trick for Apple's clear space (a quarter of the height, 12 px
     here): an invisible box around the link would overlap its neighbours
     rather than keep them away. The space comes from the margins where the
     badge is placed, and is measured in the browser, not assumed. */
  .cta__badge {
    display: inline-block;
    line-height: 0;
  }

  .cta__badge img {
    display: block;
    height: 48px;
    width: auto;
  }

  .cta__button {
    display: inline-block;
    padding: var(--space-s) var(--space-xl);
    background: var(--text-accent);
    color: var(--on-accent);
    border-radius: var(--radius);
    font-size: var(--step-1);
    font-weight: 650;
    text-decoration: none;
  }

  .cta__button:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
  }

  .cta__status {
    margin: 0;
    padding-left: var(--space-m);
    border-left: 3px solid var(--text-accent);
    color: var(--text-muted);
    max-width: 46ch;
  }

  .cta__status strong {
    color: var(--text);
  }
</style>
