---
import { RELEASE } from '../consts';

/**
 * The App Store button — or the truth, while there is nothing to link to.
 *
 * SPEC §3 puts a store button on the first screen. It reads `RELEASE`, so the
 * button and the status line cannot both be wrong in different places: before
 * 2 September 2026 this rendered "Not on the App Store yet", and switching
 * `state` and `appStoreUrl` in src/consts.ts turned every copy of it into the
 * button at once — here, twice on the home page and twice on
 * /ynab-alternative. The build fails if a released call to action renders
 * without the link inside it.
 *
 * The label is Apple's own wording, the words on their badge. "Get it on" is
 * Google Play's phrase, and the store is free to download with the purchase
 * inside, so "Download" is also the literal truth of what the click does.
 *
 * It is text rather than Apple's badge artwork. If the badge ever replaces it,
 * it goes in as a file in public/, never hotlinked from Apple's servers
 * (SPEC §9: zero third-party requests, and the CSP would block it anyway).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['cta', className]}>
  {
    RELEASE.state === 'released' && RELEASE.appStoreUrl ? (
      <a class="cta__button" href={RELEASE.appStoreUrl}>
        Download on the App Store
      </a>
    ) : (
      <p class="cta__status">
        <strong>{RELEASE.status}.</strong> No date is promised here, because a
        date would be a guess — App Review sets it.
      </p>
    )
  }
</div>

<style>
  .cta__button {
    display: inline-block;
    padding: var(--space-s) var(--space-xl);
    background: var(--text-accent);
    color: var(--on-accent);
    border-radius: var(--radius);
    font-size: var(--step-1);
    font-weight: 650;
    text-decoration: none;
  }

  .cta__button:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
  }

  .cta__status {
    margin: 0;
    padding-left: var(--space-m);
    border-left: 3px solid var(--text-accent);
    color: var(--text-muted);
    max-width: 46ch;
  }

  .cta__status strong {
    color: var(--text);
  }
</style>
