---
import { CALCULATOR, MARKETS, SITE, YNAB, money, savings } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { t, tf } from '../i18n/ui';

/**
 * What YNAB costs over the years you expect to keep budgeting, next to one
 * purchase of Fundkeep.
 *
 * Moved here from /ynab-alternative on 13.09.2026, unchanged: the штаб put it
 * on /ynab-pricing, the page for people asking what YNAB costs, and left a
 * link behind. Same markup, same `savings()` arithmetic, same script.
 *
 * Server-rendered for the default number of years, so the figures are right
 * before any script runs and stay right if it never does. The script only
 * moves them, reading every rate from the data attributes below — it holds no
 * prices of its own.
 */
interface Props {
  /** Whose storefront the arithmetic is in. */
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const ui = t(lang);
const uif = tf(lang);
const market = MARKETS[lang];
const start = savings(CALCULATOR.defaultYears, lang);
/* The word "years" is a string in four languages and a plural rule in three
   of them, so the script cannot build it out of a number. It gets both forms
   handed to it, the same way it gets the rates. */
const yearsLabel = (n: number) =>
  n === 1 ? ui('calc.yearOne') : uif('calc.yearMany', { n });
const overLabel = uif('calc.over', { years: yearsLabel(start.years) });
---

<script is:inline defer src="/savings-calculator.js"></script>

<div
  class="calculator"
  data-calculator
  data-static
  data-annual={market.ynabAnnual}
  data-monthly={market.ynabMonthly}
  data-once={start.once}
  data-intl={market.intl}
  data-currency={market.currency}
  data-year-one={ui('calc.yearOne')}
  data-year-many={ui('calc.yearMany')}
  data-over={ui('calc.over')}
  data-difference={ui('calc.difference')}
>
  <div class="calculator__control">
    <label for="years">
      {ui('calc.question')}{' '}
      <output class="calculator__years" for="years" data-out-years
        >{yearsLabel(start.years)}</output
      >
    </label>
    <input
      id="years"
      type="range"
      min={CALCULATOR.minYears}
      max={CALCULATOR.maxYears}
      step="1"
      value={start.years}
      data-years-input
    />
    <p class="calculator__ends small muted" aria-hidden="true">
      <span>{yearsLabel(CALCULATOR.minYears)}</span>
      <span>{yearsLabel(CALCULATOR.maxYears)}</span>
    </p>
  </div>

  <table class="calculator__table">
    <caption class="visually-hidden">
      <span data-out-over>{overLabel}</span>
    </caption>
    <thead>
      <tr>
        <th scope="col"><span data-out-over>{overLabel}</span></th>
        <th scope="col">{ui('calc.pay')}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">{YNAB.name}, {ui('calc.annual')}</th>
        <td data-out-annual>{money(start.annual, lang)}</td>
      </tr>
      <tr>
        <th scope="row">{YNAB.name}, {ui('calc.monthly')}</th>
        <td data-out-monthly>{money(start.monthly, lang)}</td>
      </tr>
      <tr class="calculator__ours">
        <th scope="row">{SITE.name}, {ui('calc.ours')}</th>
        <td data-out-once>{money(start.once, lang)}</td>
      </tr>
    </tbody>
  </table>

  <p class="calculator__result">
    <span data-out-difference
      >{uif('calc.difference', { years: yearsLabel(start.years) })}</span
    >:{' '}
    <strong data-out-saved>{money(start.saved, lang)}</strong>
  </p>
</div>

<style>
  /* --- Calculator -------------------------------------------------------- */

  .calculator {
    max-width: var(--measure);
    margin: var(--space-xl) 0;
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  /* Without the script the slider cannot move the figures, so it is not
     offered. The table below it is still correct — it is rendered from the
     same constants at build time — it just does not move. */
  .calculator[data-static] .calculator__control {
    display: none;
  }

  .calculator__control label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-s);
  }

  .calculator__years {
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .calculator__control input[type='range'] {
    width: 100%;
    accent-color: var(--text-accent);
  }

  .calculator__ends {
    display: flex;
    justify-content: space-between;
    margin: 0 0 var(--space-l);
  }

  .calculator__table {
    margin-bottom: var(--space-m);
  }

  .calculator__table td {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .calculator__table thead th:last-child {
    text-align: right;
  }

  .calculator__ours th,
  .calculator__ours td {
    font-weight: 700;
    color: var(--text-accent);
  }

  .calculator__result {
    margin: 0;
    font-size: var(--step-1);
  }

  .calculator__result strong {
    font-variant-numeric: tabular-nums;
  }
</style>
