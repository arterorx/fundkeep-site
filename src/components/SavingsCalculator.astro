---
import { CALCULATOR, YNAB, money, savings } from '../consts';

/**
 * What YNAB costs over the years you expect to keep budgeting, next to one
 * purchase of Fundkeep.
 *
 * Moved here from /ynab-alternative on 13.09.2026, unchanged: the штаб put it
 * on /ynab-pricing, the page for people asking what YNAB costs, and left a
 * link behind. Same markup, same `savings()` arithmetic, same script.
 *
 * Server-rendered for the default number of years, so the figures are right
 * before any script runs and stay right if it never does. The script only
 * moves them, reading every rate from the data attributes below — it holds no
 * prices of its own.
 */
const start = savings(CALCULATOR.defaultYears);
---

<script is:inline defer src="/savings-calculator.js"></script>

<div
  class="calculator"
  data-calculator
  data-static
  data-annual={YNAB.annual}
  data-monthly={YNAB.monthly}
  data-once={start.once}
>
  <div class="calculator__control">
    <label for="years">
      How long do you expect to keep budgeting?{' '}
      <output class="calculator__years" for="years" data-out-years
        >{start.years} years</output
      >
    </label>
    <input
      id="years"
      type="range"
      min={CALCULATOR.minYears}
      max={CALCULATOR.maxYears}
      step="1"
      value={start.years}
      data-years-input
    />
    <p class="calculator__ends small muted" aria-hidden="true">
      <span>{CALCULATOR.minYears} year</span>
      <span>{CALCULATOR.maxYears} years</span>
    </p>
  </div>

  <table class="calculator__table">
    <caption class="visually-hidden">
      What each option costs over <span data-out-years>{start.years} years</span>
    </caption>
    <thead>
      <tr>
        <th scope="col">Over <span data-out-years>{start.years} years</span></th>
        <th scope="col">You pay</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">{YNAB.name}, billed annually</th>
        <td data-out-annual>{money(start.annual)}</td>
      </tr>
      <tr>
        <th scope="row">{YNAB.name}, billed monthly</th>
        <td data-out-monthly>{money(start.monthly)}</td>
      </tr>
      <tr class="calculator__ours">
        <th scope="row">Fundkeep, bought once</th>
        <td data-out-once>{money(start.once)}</td>
      </tr>
    </tbody>
  </table>

  <p class="calculator__result">
    Difference over <span data-out-years>{start.years} years</span>:{' '}
    <strong data-out-saved>{money(start.saved)}</strong>
  </p>
</div>

<style>
  /* --- Calculator -------------------------------------------------------- */

  .calculator {
    max-width: var(--measure);
    margin: var(--space-xl) 0;
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  /* Without the script the slider cannot move the figures, so it is not
     offered. The table below it is still correct — it is rendered from the
     same constants at build time — it just does not move. */
  .calculator[data-static] .calculator__control {
    display: none;
  }

  .calculator__control label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-s);
  }

  .calculator__years {
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .calculator__control input[type='range'] {
    width: 100%;
    accent-color: var(--text-accent);
  }

  .calculator__ends {
    display: flex;
    justify-content: space-between;
    margin: 0 0 var(--space-l);
  }

  .calculator__table {
    margin-bottom: var(--space-m);
  }

  .calculator__table td {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .calculator__table thead th:last-child {
    text-align: right;
  }

  .calculator__ours th,
  .calculator__ours td {
    font-weight: 700;
    color: var(--text-accent);
  }

  .calculator__result {
    margin: 0;
    font-size: var(--step-1);
  }

  .calculator__result strong {
    font-variant-numeric: tabular-nums;
  }
</style>
