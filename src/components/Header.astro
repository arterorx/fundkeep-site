---
import { SITE } from '../consts';
import { DEFAULT_LOCALE, localePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import BrandMark from './BrandMark.astro';

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const ui = t(lang);
const path = Astro.url.pathname;

/**
 * Every page the navigation links to, in one array rather than per template.
 *
 * A translated page links to the pages that exist in its own language and
 * back to its own home, never to an English page with a German label. Until
 * the long comparison pages are translated, the three shorter languages get
 * a navigation of one item, which is honest; a link that changes language
 * without warning is worse than a link that is not there.
 */
const links =
  lang === DEFAULT_LOCALE
    ? [
        { href: '/ynab-alternative', label: ui('nav.leaving') },
        { href: '/blog', label: ui('nav.articles') },
        { href: '/support', label: ui('nav.support') },
        { href: '/privacy', label: ui('nav.privacy') },
      ]
    : [
        // Support and Privacy are written in English and are not translated
        // yet. They keep their English labels and are marked as English, so a
        // screen reader does not read them in the page's language and nobody
        // is promised a page in theirs. A translated label on an English page
        // is the one thing worse than an English label.
        { href: '/support', label: 'Support', foreign: true },
        { href: '/privacy', label: 'Privacy', foreign: true },
      ];

/** Articles mark the Articles tab, not just /blog itself. */
const isCurrent = (href: string) =>
  path === href ||
  path === `${href}.html` ||
  (href === '/blog' && path.startsWith('/blog/'));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={localePath(lang)} aria-label={SITE.name}>
      <BrandMark size={30} id="brand-header" class="brand__mark" />
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav aria-label="Main">
      <ul class="site-nav">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                hreflang={'foreign' in link ? 'en' : undefined}
                lang={'foreign' in link ? 'en' : undefined}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand__mark {
    border-radius: 7px;
    flex: none;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    /* Four labels have to sit on one row next to the wordmark on a 375 px
       phone. Two rows cost 44 px of the first screen — measured — and on the
       home page that was the difference between the App Store button being
       above the fold and just below it. The labels shrink rather than get
       abbreviated into guesswork. */
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .site-nav {
      gap: var(--space-l);
      font-size: inherit;
    }
  }

  .site-nav li + li {
    margin-top: 0;
  }

  .site-nav a {
    display: inline-block;
    /* The row got shorter, so the tap target gets the space back. */
    padding-block: var(--space-xs);
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-nav a[aria-current='page'] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--text-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
