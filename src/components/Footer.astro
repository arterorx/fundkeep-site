---
import { CONTACT_EMAIL } from '../consts';
import {
  DEFAULT_LOCALE,
  LOCALE_NAMES,
  type Alternate,
  type Locale,
} from '../i18n/config';
import { t } from '../i18n/ui';
import { PRIVACY, SUPPORT } from '../i18n/pages';

interface Props {
  lang?: Locale;
  /** The page's own language cluster, for the switcher. */
  alternates?: Alternate[];
}

const { lang = DEFAULT_LOCALE, alternates = [] } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();

/* The switcher only ever offers versions of the page the reader is on. A
   language button that lands everybody on a translated home page is the
   oldest way to lose them, and it also tells search engines two things that
   are not the same page. Fewer than two versions, no switcher. */
const others = alternates.filter((entry) => entry.lang !== lang);
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="small muted site-footer__note">{ui('footer.note')}</p>
    <nav aria-label="Footer">
      <ul class="footer-nav small">
        <li>
          <a href={`/${lang}/${SUPPORT[lang]}`.replace('/en/', '/')}
            >{ui('nav.support')}</a
          >
        </li>
        <li>
          <a href={`/${lang}/${PRIVACY[lang]}`.replace('/en/', '/')}
            >{ui('nav.privacy')}</a
          >
        </li>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
      </ul>
    </nav>
    <p class="small muted site-footer__copy">© {year}</p>
    {
      /* Apple's marketing guidelines: "When the App Store badge is used,
         credit both Apple and the Apple Logo", in the international form,
         listing the Apple marks that appear on the site. Rewrite the list
         when a page starts or stops naming one. Once, where the legal line
         already is, rather than on every mention. */
    }
    {
      others.length > 0 && (
        <nav class="site-footer__langs small" aria-label={ui('lang.label')}>
          <ul class="footer-nav small">
            {others.map((entry) => (
              <li>
                <a href={entry.path} hreflang={entry.lang} lang={entry.lang}>
                  {LOCALE_NAMES[entry.lang]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="small muted site-footer__legal">
      {ui('footer.legal')}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-block: var(--space-l);
  }

  .site-footer__note {
    margin: 0;
    max-width: 38ch;
  }

  .site-footer__copy {
    margin: 0;
  }

  .site-footer__langs {
    flex-basis: 100%;
  }

  .site-footer__legal {
    flex-basis: 100%;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav li + li {
    margin-top: 0;
  }
</style>
